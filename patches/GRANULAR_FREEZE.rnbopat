      {
        "box": {
          "genpatcher": {
            "patcher": {
              "fileversion": 1,
              "appversion": {
                "major": 9,
                "minor": 0,
                "revision": 0,
                "architecture": "x64",
                "modernui": 1
              },
              "classnamespace": "dsp.gen",
              "rect": [
                100,
