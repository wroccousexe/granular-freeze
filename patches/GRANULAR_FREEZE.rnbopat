              ],
              "boxes": [
                {
                  "box": {
                    "maxclass": "codebox",
                    "patching_rect": [
                      60,
                      80,
                      900,
                      580
                    ],
                    "outlettype": [
                      "",
                      ""
                    ],
                    "fontname": "<Monospaced>",
                    "fontface": 0,
                    "id": "code",
                    "numinlets": 11,
                    "fontsize": 12,
                    "numoutlets": 2,
                    "code": "// Port of III/009-GRANULAR_FREEZE.maxpat and III/granula.maxpat.\n// Mono capture, stereo equal-power panning, 64 voices, Hann envelopes.\nData audio(131072);\nData voices(64, 4);\nHistory writepos(0);\nHistory recording(0);\nHistory ready(0);\nHistory previousCapture(0);\nHistory previousClear(0);\nHistory countdown(0);\nHistory wetSmooth(0);\nHistory gainSmooth(0);\nHistory initialized(0);\n\ncapture = in3 >= 0.5;\nclear = in8 >= 0.5;\nbuflen = min(131072, max(1, floor(samplerate * 0.15)));\nif (initialized == 0 || (clear && !previousClear) || (capture && !previousCapture)) {\n    for (i = 0; i < 64; i += 1) {\n        poke(voices, 0, i, 0);\n        poke(voices, 0, i, 1);\n    }\n    ready = 0;\n    recording = 0;\n    writepos = 0;\n    countdown = 0;\n    initialized = 1;\n}\nif (capture && !previousCapture) {\n    recording = 1;\n}\nif (clear && !previousClear) {\n    recording = 0;\n}\nif (recording) {\n    poke(audio, in1, writepos);\n    writepos = writepos + 1;\n    if (writepos >= buflen) {\n        recording = 0;\n        ready = 1;\n        countdown = 0;\n    }\n}\npreviousCapture = capture;\npreviousClear = clear;\ninterval = max(1, in7 * samplerate * 0.001);\nduration = max(2, in5 * samplerate * 0.001);\nif (ready && in11 >= 0.5) {\n    if (countdown <= 0) {\n        chosen = -1;\n        for (i = 0; i < 64; i += 1) {\n            if (chosen < 0 && peek(voices, i, 1) <= 0) { chosen = i; }\n        }\n        if (chosen >= 0) {\n            poke(voices, 0, chosen, 0);\n            poke(voices, duration, chosen, 1);\n            poke(voices, clamp(in4 * samplerate * 0.001, 0, buflen - 1), chosen, 2);\n            poke(voices, clamp(in6, 0, 1), chosen, 3);\n        }\n        countdown = countdown + interval;\n    }\n    countdown = countdown - 1;\n}\nleft = 0;\nright = 0;\nfor (i = 0; i < 64; i += 1) {\n    len = peek(voices, i, 1);\n    if (len > 0) {\n        age = peek(voices, i, 0);\n        pos = peek(voices, i, 2) + age;\n        idx = floor(pos);\n        frac = pos - idx;\n        sample = 0;\n        if (idx >= 0 && idx < buflen) {\n            a = peek(audio, idx);\n            b = 0;\n            if (idx + 1 < buflen) { b = peek(audio, idx + 1); }\n            sample = a + frac * (b - a);\n        }\n        envelope = 0.5 - 0.5 * cos(6.283185307179586 * age / len);\n        p = peek(voices, i, 3) * 1.570796326794897;\n        left = left + sample * envelope * cos(p);\n        right = right + sample * envelope * sin(p);\n        age = age + 1;\n        poke(voices, age, i, 0);\n        if (age >= len) { poke(voices, 0, i, 1); }\n    }\n}\n// Keep overlapping grains at a practical level; smooth host automation.\nnorm = 1 / max(1, 0.5 * duration / interval);\nsmoothing = 1 - exp(-1 / (samplerate * 0.005));\nwetSmooth = wetSmooth + smoothing * (clamp(in9, 0, 1) - wetSmooth);\ngainSmooth = gainSmooth + smoothing * (pow(10, clamp(in10, -60, 6) / 20) - gainSmooth);\nout1 = ((1 - wetSmooth) * in1 + wetSmooth * left * norm) * gainSmooth;\nout2 = ((1 - wetSmooth) * in2 + wetSmooth * right * norm) * gainSmooth;\n"
                  }
                },
